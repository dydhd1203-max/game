+# ---------------------------------------------------------------------------
+# One build's context: registered upload, change maps, colour models
+# ---------------------------------------------------------------------------
+class Context:
+    def __init__(self, res, slot, sexes=('m', 'f'), fz=None):
+        self.fz = fz or frozen()
