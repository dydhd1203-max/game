+        'f-front': dict(cut=964, apex=957, cuff=983, rise=16), 'f-back': dict(cut=962, apex=956, cuff=980.5, rise=16)}
+SIDE_SEAT = {'m-right': dict(cut=449, cuff=465.5), 'f-right': dict(cut=970, cuff=988.5)}
