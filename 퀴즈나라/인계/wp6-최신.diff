+PART_LAYER = {'torso': 'shirt', 'sleeve0': 'sleeves', 'sleeve1': 'sleeves', 'bottom': 'shorts', 'shoe0': 'shoes', 'shoe1': 'shoes'}
+PART_OWN = {'torso': 1, 'sleeve0': 2, 'sleeve1': 2, 'bottom': 4, 'shoe0': 6, 'shoe1': 6}
