{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tools/garment/schema.json",
  "title": "QUIZ나라 foundation garment record",
  "description": "One product of the foundation avatar (stage 3), keyed 'cat:shape'. The catalogue colour index ci is ignored for lookup and kept per sex as a legacy token. Records are generated (tools/garment/pack-basic.py for the legacy basic outfit, the pipeline later), never hand-edited, and validated by tools/garment/schema.cjs, which also runs the semantic checks named in x-checks. Units: sheet px (the 1448x1086 reference sheet) unless a field says atlas px, sleeve-frame units (u along/across the resting upper arm from the shoulder, 1 u = 1/k sheet px) or body-local units.",
  "x-version": 1,
  "x-sheet": {"width": 1448, "height": 1086, "rows": {"m": [0, 555], "f": [555, 1086]}},
  "x-classes": {
    "runtime": ["top/short-sleeve", "bottom/shorts", "shoes/low"],
    "reserved": ["top/long-sleeve", "top/sleeveless", "bottom/trousers", "bottom/skirt", "onepiece/dress", "shoes/boots", "shoes/sandals"],
    "note": "Reserved classes may appear in a record (the runtime falls back with reason 'class'), but the stage-3 builder refuses to build them (schema.cjs validate(record,{builder:true}) → CLASS_RESERVED)."
  },
  "x-slots": {
    "top": {"cat": "top", "slots": ["top"], "parts": ["top"]},
    "bottom": {"cat": "bottom", "slots": ["bottom"], "parts": ["bottom"]},
    "onepiece": {"cat": "outfit", "slots": ["top", "bottom"], "parts": ["top", "bottom"]},
    "shoes": {"cat": "shoes", "slots": ["shoes"], "parts": ["shoes"]}
  },
  "x-views": {
    "front": {"pairs": 2, "seat": "seat"},
    "right": {"pairs": 1, "seat": "sideSeat", "note": "profile: one sleeve and one shoe serve both sides (the reference rects are identical); index i uses entry min(i, n-1)"},
    "back": {"pairs": 2, "seat": "seat"}
  },
  "x-legacyComputed": {
    "note": "A legacy record (the packed basic outfit, until WP11) leaves these fields null: today's runtime code still computes them, keyed by garment id. A pipeline record (legacy:false) must fill them.",
    "top": ["sleeves.raisedAt", "sleeves.opening", "top.underarm", "top.hem", "top.collar"],
    "bottom": ["bottom.waistTop", "bottom.edgeTone", "bottom.cuffAlong", "sideSeat.span"],
    "shoes": ["shoes.opening", "shoes.sole"]
  },
  "x-files": {
    "encoding": "id 'cat:shape' → stem 'cat-shape' (cat [a-z]+, shape [a-z0-9_]+, so the first '-' splits them and '_' survives: 'bottom:jean_skirt' ↔ 'bottom-jean_skirt').",
    "data": "assets/sd-garment-<stem>.js",
    "atlas": "assets/sd-garment-<stem>-<m|f>.png",
    "bundle": "assets/avatar-file-data-garment-<stem>.js (file:// bundle, generated by the runtime work package)",
    "index": "assets/sd-garments-index.js",
    "atlasPattern": "^assets/sd-garment-([a-z]+)-([a-z0-9_]+)-(m|f)\\.png$",
    "registry": "Each data file adds its record to window.QPFoundationGarmentRecords[id] (one shared registry, one key per record; never a per-file global that another file would overwrite) and calls window.QPFoundationGarments.define(record) when the runtime registry is present."
  },
  "x-checks": {
    "SCHEMA": "structure (this file)",
    "ID": "id = cat:shape; cat, slot, slots and class prefix agree (x-slots)",
    "CLASS_RESERVED": "builder mode only: reserved classes are refused; legacy records must have a runtime class",
    "LEGACY": "legacy ⇔ legacyComputed lists exactly x-legacyComputed[slot parts] and those fields are null; a pipeline record fills them",
    "SEXES": "sexes, catalog and mirrorSafe name the same sexes",
    "FILES": "atlas paths follow x-files",
    "VIEWS": "front/right/back present, parts = x-slots[slot].parts, sleeve/shoe/underarm counts = x-views pairs, seat in front/back and sideSeat in right for bottom/shorts",
    "ATLAS": "every atlas region (at/raisedAt + rect size) lies inside the atlas, no two regions overlap",
    "SHEET": "every rect lies inside the sheet rows of its sex",
    "CATALOG": "item = id:ci, colours are #rrggbb",
    "ANCHOR": "context: sleeve shoulder / shoe ankle equal the frozen body joints",
    "LEGACY_RECT": "context, legacy: rects equal the legacy garment rects of sd-foundation-ref-data.js",
    "CUFF": "context, legacy: cuff = (cuff_top − shoulder_y)·k exactly",
    "BOX": "context: sleeve box = the sleeve mesh canvas (avatar-foundation-outfit.js, ±4 u) for legacy records; w,h > 0 always",
    "SEAT": "context, legacy: seat/sideSeat equal SEAT/SIDE_SEAT of avatar-foundation-outfit.js",
    "ATLAS_FILE": "files: atlas sha256, PNG chunks IHDR/IDAT/IEND only, 8-bit RGBA, IHDR size = size"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "cat", "shape", "slot", "slots", "class", "status", "legacy", "legacyComputed", "bodyArt", "catalog", "mirrorSafe", "source", "checks", "sexes"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z]+:[a-z0-9_]+$"},
    "cat": {"enum": ["top", "bottom", "outfit", "shoes"]},
    "shape": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "slot": {"enum": ["top", "bottom", "onepiece", "shoes"]},
    "slots": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["top", "bottom", "shoes"]}},
    "class": {"enum": ["top/short-sleeve", "bottom/shorts", "shoes/low", "top/long-sleeve", "top/sleeveless", "bottom/trousers", "bottom/skirt", "onepiece/dress", "shoes/boots", "shoes/sandals"]},
    "status": {"enum": ["candidate", "approved", "retired"]},
    "legacy": {"type": "boolean", "description": "true only for the packed basic outfit until its pipeline rebuild (WP11)"},
    "legacyComputed": {"type": "array", "uniqueItems": true, "items": {"enum": ["sleeves.raisedAt", "sleeves.opening", "top.underarm", "top.hem", "top.collar", "bottom.waistTop", "bottom.edgeTone", "bottom.cuffAlong", "sideSeat.span", "shoes.opening", "shoes.sole"]}},
    "bodyArt": {"enum": ["legacy", "clean"], "description": "the limb/neck art the garment was fitted against: legacy layers (sd-foundation-ref-arms/neck.png) or the rule-cleaned ones (-clean.png)"},
    "catalog": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"m": {"$ref": "#/$defs/catalogEntry"}, "f": {"$ref": "#/$defs/catalogEntry"}}
    },
    "mirrorSafe": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "description": "the right-view art may be mirrored for the left view (no lettering or one-sided print)",
      "properties": {"m": {"type": "boolean"}, "f": {"type": "boolean"}}
    },
    "source": {"$ref": "#/$defs/source"},
    "checks": {"$ref": "#/$defs/checks"},
    "sexes": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"m": {"$ref": "#/$defs/sex"}, "f": {"$ref": "#/$defs/sex"}}
    }
  },
  "$defs": {
    "int": {"type": "integer", "minimum": 0},
    "rect": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}, "description": "[x, y, w, h], sheet px, integers"},
    "at": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}, "description": "[x, y] of the rect's copy in the atlas, atlas px"},
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "points": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point"}},
    "hex": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
    "tone": {"type": "string", "pattern": "^(#[0-9a-f]{6}|rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(0|1|0?\\.\\d+)\\))$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[^/\\\\.][^\\\\]*$"},
    "fileRef": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "nullable": {"type": "null", "description": "reserved, empty in stage 3"},
    "catalogEntry": {
      "type": "object", "additionalProperties": false, "required": ["item", "ci", "name", "colour", "display", "legacyIds"],
      "properties": {
        "item": {"type": "string", "pattern": "^[a-z]+:[a-z0-9_]+:\\d+$", "description": "the shop item this sex sees (fixed colour), e.g. top:tee:5"},
        "ci": {"type": "integer", "minimum": 0, "description": "legacy colour token of that item"},
        "name": {"type": "string", "minLength": 1},
        "colour": {"$ref": "#/$defs/hex", "description": "QPGame.getCatalog().curatedItem(cat,shape,sex).color"},
        "display": {"$ref": "#/$defs/hex", "description": "the colour today's student renderer paints: QPClothes.colorFor(cat,shape,sex,colour) — the male override (maleColors) or the catalogue colour"},
        "legacyIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]+:[a-z0-9_]+:\\d+$"}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sheet", "layers", "data", "template", "designRef", "prompt", "registration", "bodyFieldsSha256", "builder", "date"],
      "properties": {
        "kind": {"enum": ["legacy-basic", "chatgpt-sheet", "synthetic"]},
        "sheet": {"oneOf": [{"$ref": "#/$defs/fileRef"}, {"type": "null"}], "description": "the drawing the garment was cut from (sha256 of the bytes as stored)"},
        "layers": {"oneOf": [{"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/fileRef"}}, {"type": "null"}], "description": "legacy: the full-sheet layers the atlases were cropped from"},
        "data": {"oneOf": [{"$ref": "#/$defs/fileRef"}, {"type": "null"}], "description": "legacy: sd-foundation-ref-data.js the rects came from"},
        "template": {"oneOf": [{"$ref": "#/$defs/fileRef"}, {"type": "null"}]},
        "designRef": {"oneOf": [{"$ref": "#/$defs/fileRef"}, {"type": "null"}]},
        "prompt": {"oneOf": [{"type": "null"}, {
          "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": ["string", "integer"]}, "sha256": {"$ref": "#/$defs/sha256"}}
        }]},
        "registration": {"oneOf": [{"type": "null"}, {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["s", "dx", "dy", "residual", "stableIoU", "dE"],
            "properties": {"s": {"type": "number"}, "dx": {"type": "number"}, "dy": {"type": "number"}, "residual": {"type": "number"}, "stableIoU": {"type": "number"}, "dE": {"type": "number"}}
          }
        }]},
        "bodyFieldsSha256": {"$ref": "#/$defs/sha256", "description": "frozen-body.json bodyFieldsSha256 the record was built against"},
        "builder": {"type": "string", "pattern": "^tools/[\\w./-]+\\.(py|cjs)(@[0-9a-f]{7,40})?$"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["codes", "warnings", "overlap", "collarMargin", "hiddenRebuiltPct", "limits"],
      "properties": {
        "codes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z_]+$"}, "description": "failed limit codes (empty for a record that may ship)"},
        "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "overlap": {"type": ["number", "null"]},
        "collarMargin": {"type": ["number", "null"]},
        "hiddenRebuiltPct": {"type": ["number", "null"]},
        "limits": {"oneOf": [{"type": "null"}, {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256", "minMarginPx"],
          "properties": {
            "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"},
            "minMarginPx": {"type": "object", "additionalProperties": false, "properties": {"m": {"type": "number"}, "f": {"type": "number"}}}
          }
        }]}
      }
    },
    "sex": {
      "type": "object", "additionalProperties": false, "required": ["atlas", "size", "sha256", "figures"],
      "properties": {
        "atlas": {"type": "string", "pattern": "^assets/sd-garment-[a-z]+-[a-z0-9_]+-(m|f)\\.png$"},
        "size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 4096}},
        "sha256": {"$ref": "#/$defs/sha256"},
        "figures": {
          "type": "object", "additionalProperties": false, "required": ["front", "right", "back"],
          "properties": {
            "front": {"$ref": "#/$defs/figure"}, "right": {"$ref": "#/$defs/figure"}, "back": {"$ref": "#/$defs/figure"},
            "left": {"$ref": "#/$defs/nullable", "description": "reserved: own left-view art instead of mirroring the right view"}
          }
        }
      }
    },
    "figure": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "top": {"$ref": "#/$defs/topPart"},
        "bottom": {"$ref": "#/$defs/bottomPart"},
        "shoes": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/shoe"}},
        "forearmSleeve": {"$ref": "#/$defs/nullable"},
        "shin": {"$ref": "#/$defs/nullable"},
        "skirt": {"$ref": "#/$defs/nullable"},
        "shaft": {"$ref": "#/$defs/nullable"},
        "skinParts": {"$ref": "#/$defs/nullable"},
        "seated": {"$ref": "#/$defs/nullable", "description": "reserved: seated pictures {floor-front, floor-back, floor-side, desk}"}
      }
    },
    "region": {
      "type": "object", "additionalProperties": false, "required": ["rect", "at"],
      "properties": {"rect": {"$ref": "#/$defs/rect"}, "at": {"$ref": "#/$defs/at"}}
    },
    "topPart": {
      "type": "object", "additionalProperties": false, "required": ["torso", "sleeves", "underarm", "hem", "collar"],
      "properties": {
        "torso": {"$ref": "#/$defs/region", "description": "the shirt body, placed by the frozen neck anchor"},
        "sleeves": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/sleeve"}},
        "underarm": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/underarmSide"}}], "description": "per side, body-local units: the shirt side edge and the sleeve underside used for a raised arm (avatar-foundation-outfit.js shirtSide)"},
        "hem": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/points"}], "description": "hem outline, sheet px"},
        "collar": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/points"}], "description": "neck opening outline, sheet px"}
      }
    },
    "sleeve": {
      "type": "object", "additionalProperties": false, "required": ["rect", "at", "raisedAt", "shoulder", "cuff", "opening", "box"],
      "properties": {
        "rect": {"$ref": "#/$defs/rect"},
        "at": {"$ref": "#/$defs/at"},
        "raisedAt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/at"}], "description": "atlas px of the raised-arm drawing (same size as rect); null: the runtime makes it (legacy)"},
        "shoulder": {"$ref": "#/$defs/point", "description": "anchor: the frozen shoulder joint, sheet px"},
        "cuff": {"type": "number", "description": "where the cuff begins along the resting upper arm, sleeve-frame u from the shoulder"},
        "opening": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point"}}], "description": "cuff opening outline [[w,t]…], sleeve-frame u"},
        "box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}, "description": "[x0,y0,w,h] sleeve-frame u covered by the sleeve mesh canvas"}
      }
    },
    "underarmSide": {
      "type": "object", "additionalProperties": false, "required": ["side", "edge", "hem", "cap", "inset", "cloth", "line", "under", "cuff"],
      "properties": {
        "side": {"enum": [-1, 1]},
        "edge": {"$ref": "#/$defs/points"},
        "hem": {"type": "number"},
        "cap": {"$ref": "#/$defs/point"},
        "inset": {"type": "number"},
        "cloth": {"$ref": "#/$defs/hex"},
        "line": {"$ref": "#/$defs/hex"},
        "under": {
          "type": "object", "additionalProperties": false, "required": ["t0", "w"],
          "properties": {"t0": {"type": "number"}, "w": {"type": "array", "minItems": 1, "items": {"type": "number"}}}
        },
        "cuff": {"type": "number"}
      }
    },
    "bottomPart": {
      "type": "object", "additionalProperties": false, "required": ["rect", "at", "waistTop", "edgeTone", "cuffAlong"],
      "properties": {
        "rect": {"$ref": "#/$defs/rect"},
        "at": {"$ref": "#/$defs/at"},
        "waistTop": {"type": ["number", "null"], "description": "sheet row of the waistband's top"},
        "edgeTone": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tone"}], "description": "the drawing's own outline colour for seated outlines"},
        "cuffAlong": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "number"}}], "description": "per leg: the cuff's place along the thigh, thigh lengths from the hip"},
        "seat": {
          "type": "object", "additionalProperties": false, "required": ["cut", "apex", "cuff", "rise"],
          "description": "front/back seated shorts (sheet rows / px): cut just above the cuffs, apex the crotch notch, cuff the cuff's lower outline, rise how far the cuff's upper outline climbs at the outer sides",
          "properties": {"cut": {"type": "number"}, "apex": {"type": "number"}, "cuff": {"type": "number"}, "rise": {"type": "number"}}
        },
        "sideSeat": {
          "type": "object", "additionalProperties": false, "required": ["cut", "cuff"],
          "description": "profile floor-sit shorts (sheet rows): cut just above the cuff's upper outline, cuff the lower outline; span the opaque [x0,x1] on row cut-1, body-local u",
          "properties": {"cut": {"type": "number"}, "cuff": {"type": "number"}, "span": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/point"}]}}
        }
      }
    },
    "shoe": {
      "type": "object", "additionalProperties": false, "required": ["rect", "at", "ankle", "opening", "sole"],
      "properties": {
        "rect": {"$ref": "#/$defs/rect"},
        "at": {"$ref": "#/$defs/at"},
        "ankle": {"$ref": "#/$defs/point", "description": "anchor: the frozen ankle joint, sheet px"},
        "opening": {"type": ["number", "null"], "description": "sheet row of the shoe's top opening"},
        "sole": {"type": ["number", "null"], "description": "sheet row of the sole's lower edge"}
      }
    },
    "index": {
      "description": "assets/sd-garments-index.js → QPFoundationGarmentIndex (tools/garment/build-index.cjs)",
      "type": "object", "additionalProperties": false,
      "required": ["schema", "generator", "records", "catalogue", "starter", "starterItems", "runtimeClasses"],
      "properties": {
        "schema": {"const": 1},
        "generator": {"const": "tools/garment/build-index.cjs"},
        "records": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["slot", "class", "status", "legacy", "sexes", "sha256", "files"],
            "properties": {
              "slot": {"enum": ["top", "bottom", "onepiece", "shoes"]},
              "class": {"$ref": "#/properties/class"},
              "status": {"$ref": "#/properties/status"},
              "legacy": {"type": "boolean"},
              "sexes": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["m", "f"]}},
              "sha256": {"$ref": "#/$defs/sha256", "description": "of the data file bytes"},
              "files": {
                "type": "object", "additionalProperties": false, "required": ["data", "bundle"],
                "properties": {
                  "data": {"type": "string", "pattern": "^assets/sd-garment-[a-z]+-[a-z0-9_]+\\.js$"},
                  "m": {"type": "string", "pattern": "^assets/sd-garment-[a-z]+-[a-z0-9_]+-m\\.png$"},
                  "f": {"type": "string", "pattern": "^assets/sd-garment-[a-z]+-[a-z0-9_]+-f\\.png$"},
                  "bundle": {"type": "string", "pattern": "^assets/avatar-file-data-garment-[a-z]+-[a-z0-9_]+\\.js$"}
                }
              }
            }
          }
        },
        "catalogue": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-z]+:[a-z0-9_]+$"}, "description": "'sex:cat:shape' → record id; ci is ignored for lookup; a missing key falls back with reason 'todo'"},
        "starter": {
          "type": "object", "additionalProperties": false, "required": ["m", "f"],
          "properties": {
            "m": {"$ref": "#/$defs/starterSet"}, "f": {"$ref": "#/$defs/starterSet"}
          }
        },
        "starterItems": {
          "type": "object", "additionalProperties": false, "required": ["m", "f"],
          "properties": {
            "m": {"$ref": "#/$defs/starterItemSet"}, "f": {"$ref": "#/$defs/starterItemSet"}
          }
        },
        "runtimeClasses": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/properties/class"}}
      }
    },
    "starterSet": {
      "type": "object", "additionalProperties": false, "required": ["top", "bottom", "shoes"],
      "properties": {
        "top": {"type": "string", "pattern": "^top:[a-z0-9_]+$"},
        "bottom": {"type": "string", "pattern": "^bottom:[a-z0-9_]+$"},
        "shoes": {"type": "string", "pattern": "^shoes:[a-z0-9_]+$"}
      }
    },
    "starterItemSet": {
      "type": "object", "additionalProperties": false, "required": ["top", "bottom", "shoes"],
      "properties": {
        "top": {"type": "string", "pattern": "^top:[a-z0-9_]+:\\d+$"},
        "bottom": {"type": "string", "pattern": "^bottom:[a-z0-9_]+:\\d+$"},
        "shoes": {"type": "string", "pattern": "^shoes:[a-z0-9_]+:\\d+$"}
      }
    }
  }
}
