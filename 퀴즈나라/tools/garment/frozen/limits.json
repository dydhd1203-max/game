 "classes": {
  "bottom/shorts": {
   "GHOST_EDGE": {
    "rule": "every leg contact-band pixel is covered by the bottom",
    "why": "Legacy leg art carries the basic shorts cuff line (contact band 3); no clean legs yet."
   },
   "SHORTS_LONG": {
    "rule": "cuff edge <= knee - floorSitTubeEndU",
    "why": "Floor-sit tubes end .42 u before the knee (avatar-foundation-outfit.js seatedShorts)."
   },
   "SHORTS_SHORT": {
    "rule": "cuff edge >= legs hidden row on the leg band",
    "why": "Leg art above the legs hidden row (shorts_bottom - 8) is copied rows without outline."
   },
   "SKIRT_LIKE": {
    "rule": "the centre column is open between the crotch and the cuff (front/back)",
    "why": "One shorts mesh with the centre seam at body x=16 splits into two legs."
   },
   "WAIST_VISIBLE": {
    "rule": "bottom pixels visible above the frozen hem - seam tolerance = 0",
    "why": "Bottoms are drawn under the top and extended up to W; their own waistband must not show below the top hem."
   }
  },
  "shoes/low": {
   "SHOE_HIGH": {
    "rule": "shoe top >= ankle - 20 px",
    "why": "Low shoes (class rule: opening under the ankle bone, never a boot)."
   },
   "SHOE_LOW_OPENING": {
    "rule": "shoe top <= leg art end + seam tolerance",
    "why": "The leg painting ends at the basic shoe top: a lower opening shows its cut end."
   },
   "SHOE_MISSING": {
    "rule": "a shoe on each foot band",
    "why": "Both feet are drawn in front/back views."
   },
   "SOLE_OFF_FLOOR": {
    "rule": "|sole edge - floor| <= seam tolerance",
    "why": "Shoes hang from the ankle joint (floor - 30); the sole must sit on the frozen floor."
   }
  },
  "top/short-sleeve": {
   "CAP_HIGH": {
    "rule": "front/back, columns outward of S: top rows >= S.y - collarAllowU - seam tolerance",
    "why": "A gesture-raised arm carries its whole sleeve (hold 0), so a crown taller than the shoulder swings toward the head and the bob (RT minor finding). Outward of the shoulder point S (armhole S of the build, on the sheet outline: the shoulder line for boys, the bob edge for girls) the top may rise collarAllowU above S, plus the seam tolerance every measured upload edge carries (registration <= .6 px + seam <= 2 px). A row proxy until the WP7 raised-arm probe (no sleeve pixel in the head/neck capsule)."
   },
   "COLLAR_HIGH": {
    "rule": "girls front/back: collar columns >= outline - collarAllowU, shoulder columns >= min(outline, S.y) - collarAllowU; otherwise >= head cut + 1",
    "why": "Girls, front/back: the shared hair clip (FRONT_HAIR_CLIP/BACK_HAIR_CLIP) keeps >= .10 head units over the collar/shoulder outline; the measured nod-peak margin is .40, so the outline may rise (.40-.10)*HEAD_SCALE u (H1 will replace this with the per-column clip line). Boys and profile views: no hair hangs over the collar; the head is drawn over the body, so the limit is the head cut (the top must not paint into the head)."
   },
   "GHOST_EDGE": {
    "rule": "every contact-band pixel is covered by the top at rest",
    "why": "Legacy arm/neck art carries the basic cuff/collar edge (contact bands). Only for a top that is drawn on the legacy art; the clean art has no band. The basic itself is exempt: the band is its own cuff/collar outline."
   },
   "HEM_HIGH": {
    "rule": "hem >= W + .24 u on every torso column not covered by the hanging arm",
    "why": "Seated breathing lifts the chest SEATED_BREATH.rise over the seat. Bottoms are extended up to the waist cover line W (shorts top - .24 u - seam tolerance), so a top must reach W + .24 u (.14 rise + .10)."
   },
   "HEM_LOW": {
    "rule": "hem <= hip row + .25 u",
    "why": "Short-sleeve tops end above the leg joints: past hip + .25 u the rigid hem lies over the swinging thighs."
   },
   "NECK_OPEN": {
    "rule": "skin of the upload inside the frozen top region, not covered by the new top (and not arm, hair or under the head: head cut + VIEW_HEAD front drop), lies inside the clean neck art (alpha > 200) eroded 1 px; the 1 px rim at the new top edge is the seam",
    "why": "The torso has no skin art: skin may show only where the neck painting is opaque."
   },
   "SLEEVE_LONG": {
    "rule": "max t of top pixels on the arm band (|c| <= re/2) <= tElbow + re (t along the resting upper arm, px)",
    "why": "A folded forearm (run, jump, cheer) is pasted over its own sleeve; its clip ends in a round cap of radius re past the elbow (avatar-foundation-skin.js forearmOverlay). Sleeve cloth on the arm band beyond elbow + re would stick out past the folded elbow."
   },
   "SLEEVE_SHORT": {
    "rule": "every arm-band line is covered from the shoulder down to tHidden (the cuff_top row)",
    "why": "Above the clean-art top row (cuff_top) the arm layer is copied skin without outline (build-reference-body.py limb extension). It must stay under the sleeve."
   }
  }
